---
import "../styles/global.css"
import HeaderComponent from "../components/HeaderComponent.astro"
import FooterComponent from "../components/FooterComponent.astro"

---
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>T&G Music</title>
</head>
<body>
		<!--se agrego el HeaderComponent dentro del header-->

		<header><HeaderComponent/></header>
		<!--apartado principal para colocar el contenido-->
		<main>

			<slot />

		</main>
		<!--cambie de lugar el keyframe slider del index al layout para que este presente en todas las  paginas -->
		<style>
            @keyframes slide {
                0%, 20% { transform: translateX(0%); }
                33%, 53% { transform: translateX(-33.3333%); }
                66%, 86% { transform: translateX(-66.6666%); }
                100% { transform: translateX(0%); }
            }
        </style>
		<!--se agrego el FooterComponent dentro del footer-->
		<footer><FooterComponent/></footer>

	
</body>
</html>

