---
import ItemRedes from "./MenuRedesComponent.astro"
import TitlesComponent from "./TitlesComponent.astro"
---
<!--aplicamos  titlescomponent para hacer el codigo mas dry -->

 <footer class="bg-azul-medio py-5 text-center grid grid-cols-1  justify-items-center justify-between items-center">
    <div class="text-blanco gap-6 flex flex-col items-center">  
            <TitlesComponent titulo="T&G Music" tamaño="h1" estilo="text-3xl font-bold my-3" /><img src="https://cdn-icons-png.flaticon.com/512/820/820644.png" alt="logo de latienda" class="h-12 w-12">
      
       </div>
    <div class="w-full flex flex-col items-center justify-center py-5 px-4 sm:px-6 md:px-10">
        <TitlesComponent  titulo="Mantente al dia con nuestras ofertas!" estilo="text-blanco sm:text-xl mb-4  font-semibold" tamaño="h3"></TitlesComponent>
        <div class="text-center w-full max-w-md px-5">
           <div class="space-y-2">
            <input type="email" placeholder="Ingresa tu correo" class="w-full mt-2 px-5 py-2 rounded-lg text-blanco ">
            <br>
            <button onclick="subscribirse" type="submit" class="text-blanco font-semibold px-4 py-2 rounded-lg bg-azul-oscuro"><a href="/">Subscribirse</a></button>   
            
           </div>
        </div>
    </div>
     <!--links-->
    <div class="w-full px-4 sm:px-6 md:px-10 lg:px-20">    
         
    </div>
    
    <!--importamos menu itemredes -->
    <TitlesComponent titulo="Redes sociales" estilo="text-2xl text-blanco font-semibold my-3" tamaño="h2"/>
    <ItemRedes />
    
   
</footer>
        
