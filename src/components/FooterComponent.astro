---
import ItemRedes from "./MenuRedesComponent.astro"
import ItemNavMenu from "./MenuNavComponent.astro"
import TitlesComponent from "./TitlesComponent.astro"
---


 <footer class="bg-gray-700 py-6 text-center grid grid-cols-1  justify-items-center justify-between items-center">
    <div class="text-white gap-6">  
            <TitlesComponent titulo="T&G Music" tamaño="h1" estilo="text-3xl font-bold my-3" /><img src="https://cdn-icons-png.flaticon.com/512/820/820644.png" alt="" class="h-12 w-12">
        <!--nav del menu importado-->     
       </div>
    <div class="w-full bg-gray-700 flex flex-col items-center justify-center py-5 px-4 sm:px-6 md:px-10">
        <div class="text-center w-full max-w-md px-5">
           <div class="space-y-2">
            <TitlesComponent  titulo="Mantente al dia con nuestras ofertas!" estilo="text-white sm:text-xl mb-4  font-semibold" tamaño="h3">
            <input type="email" placeholder="Ingresa tu correo" class="w-full mt-2 bg-white px-5 py-2 rounded-lg">
            <br>
            <a href="/"><button onclick="subscribirse" type="submit" class="bg-white text-gray-800 font-semibold px-4 py-2 rounded-lg">Subscribirse</button></a>

           </div>
        </div>
    </div>
     <!--links-->
    <div class="w-full px-4 sm:px-6 md:px-10 lg:px-20">    
         
    </div>
    <div><ItemNavMenu /></div>
    
    <!--importamos menu itemredes -->
    <TitlesComponent titulo="Redes sociales" estilo="text-2xl text-white font-semibold my-3" tamaño="h2"/>
    <ItemRedes />
    
   
</footer>
        
