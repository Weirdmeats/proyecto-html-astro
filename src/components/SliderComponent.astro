---
import TitlesComponent from "./TitlesComponent.astro"
---
 <!--seccion de slider-->
    <section class="w-full mx-auto rounded-4xl max-w-screen-md text-semibold text-negro mt-15 overflow-hidden pb-20" id="slider">


        <!--imagenes el sliders-->
       <div class="flex w-[300%] transition-transform duration-3000 animate-[slide_9s_linear_infinite]">
        <!--img 1-->
         <figure class=" aspect-video relative w-full h-full">
            <a href="/Blog"><img src="https://i.ytimg.com/vi/sTd8VyujBbc/maxresdefault.jpg" alt="guitarras" class="h-full w-full object-cover"></a>
            <div class="absolute space-y-5 py-6 inset-0.5 mx-auto h-max mt-auto w-[90%]">
                

            </div>
        </figure>
        <!--img 2-->
         <figure class=" aspect-video relative w-full h-full ">
            <a href="/Blog"><img src="https://www.txirula.com/img/cms/Blog/fender/fender_original-lineup.png" alt="bajos" class="h-full w-full object-cover"></a>
            <div class="absolute space-y-5 py-6 inset-0.5 mx-auto h-max mt-auto w-[90%]">


            </div>
        </figure>

        <!--img 3-->
         <figure class=" aspect-video relative w-full h-full ">
            <a href="/Blog"><img src="https://www.txirula.com/modules/dbblog/views/img/post/Photo-credit-Sweetwater.jpg" alt=amplificadores"" class="h-full w-full object-cover"></a>
            <div class="absolute space-y-5 py-6 inset-0.5 mx-auto h-max mt-auto w-[90%]">
                
            </div>
        </figure>
       </div>
    </section>