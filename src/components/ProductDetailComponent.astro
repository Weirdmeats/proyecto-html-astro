---
import ParrafoComponent from "./ParrafoComponent.astro";
import TitlesComponent from "./TitlesComponent.astro";
//ocupamos astroprops
const { producto } = Astro.props;
---
<!--aplicamos  titlescomponent para hacer el codigo mas dry -->
<section class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 px-6 py-10">

  <div class="flex justify-center items-center">
      <div class="w-full max-w-md h-[300px] sm:h-[360px] md:h-[400px] overflow-hidden rounded-xl shadow-md">

        <img src={producto.imagen} alt={`Imagen de ${producto.modelo}`} class="w-full h-full object-cover"/>
    </div>
  </div>

  <div class="flex flex-col justify-center gap-6">


    <TitlesComponent titulo={`${producto.marca} ${producto.modelo}`} estilo="text-2xl sm:text-3xl font-semibold text-gris-oscuro" tamaño="h2"/>

      <ParrafoComponent parrafo={producto.descripcion} estilo="text-base sm:text-lg text-gris-claro"/>
        <div class="text-xl font-bold text-gris-oscuro">$ {producto.precio} CLP</div>

        <input type="number" placeholder="Cantidad" class="w-full max-w-xs px-4 py-2 rounded-full border border-gray-300 text-gris-oscuro"/>

      <button class="bg-rojo-oscuro hover:bg-red-400 text-blanco font-semibold px-6 py-3 rounded-xl w-full max-w-xs">Agregar al carrito</button>
  </div>
</section>
