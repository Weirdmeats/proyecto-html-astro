---
import Layout from '../layouts/Layout.astro'
import TitlesComponent from '../components/TitlesComponent.astro'
import SliderComponent from '../components/SliderComponent.astro'


---
<!--aplicamos  titlescomponent para hacer el codigo mas dry -->
<Layout>
    <main class="pt-10 bg-gris-masclaro">
        <div class="w-full text-center mt-16 sm:mt-10 md:mt-20 sm:mb-10 md:mb-20">
            <TitlesComponent titulo="Explora nuestros productos"  estilo="text-5xl sm:text-6xl font-semibold text-gray-700 mb-4" tamaño="h1"/>
            <TitlesComponent titulo="Contamos con una gran variedad de instrumentos musicales, tales como, guitarras, bajos y amplificadores" estilo="text-xl sm:text-2xl font-semibold text-gray-600 mb-4" tamaño="h2"/>          
        </div>
        <SliderComponent />
        <!--keyframe extraido de tailwind-->
    </main>
</Layout>
