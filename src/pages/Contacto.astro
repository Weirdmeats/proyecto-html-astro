---
import Layout from '../layouts/Layout.astro'
import TitlesComponent from '../components/TitlesComponent.astro'
import ItemRedes from '../components/MenuRedesComponent.astro'
import ParrafoComponent from '../components/ParrafoComponent.astro'
---


<Layout>

    <!--ARREGLAR TODO DESDE 0 PARA QUE QUEDE DRYCODE -->

<!--main contacto-->
<main class="flex-grow bg-gradient-to-br from-gray-500 via-white to-red-300 pb-20 pt-0">
  <TitlesComponent titulo='Contacto' estilo='text-semibold text-6xl text-slate-700 text-center uppercase' tamaño='h1'/>
  <!--contacto-->
  <div class="container mx-auto p-8 grid grid-cols-1 md:grid-cols-2 items-start gap-10">
    <!--columna 1-->
    <div class="flex justify-center mt-10">
      <form class="bg-white p-4 text-center rounded-2xl w-full max-w-md py-6 space-y-5" action="">
        <TitlesComponent titulo='Envíanos tu solicitud de contacto' estilo='text-2xl font-semibold text-gray-700'' tamaño='h2'/>

        
          <div class="flex flex-col space-y-2">
            <TitlesComponent titulo='Nombre' estilo='text-xl text-gray-700' tamaño='h3'/>
            <input type="text" placeholder="Ingresa tu nombre" class="rounded-lg w-full h-10 text-base text-gray-800 p-4">
          </div>

          <div class="flex flex-col space-y-2">
            <TitlesComponent titulo='Email' estilo='text-xl text-gray-700' tamaño='h3'/>
            <input type="email" placeholder="Ingresa tu email" class="rounded-lg w-full h-10 text-base text-gray-800 p-4">
          </div>

          <div class="flex flex-col space-y-2">
            <TitlesComponent titulo='Mensaje' estilo='text-xl text-gray-700' tamaño='h3'/>
            <textarea class="rounded-lg p-4" name="mensaje" id="mensaje" placeholder="Ingresa tu mensaje"></textarea>
          </div>

        <div class="flex flex-col space-y-2">
          <button class="px-12 py-2 bg-red-300 rounded-lg hover:bg-red-200" type="submit">Enviar</button>
        </div>
      </form>
    </div>

    <!--columna 2 -->
    <div class="flex justify-center pt-10">
      <div class="bg-white p-5 text-start rounded-2xl w-full max-w-md py-3">
        <TitlesComponent titulo='Contactos' estilo='text-2xl font-semibold text-gray-700 text-center' tamaño='h2'/>
        <div class="flex flex-col space-y-1">
          <TitlesComponent titulo='Redes sociales' estilo='text-lg font-bold my-4' tamaño='h3'/>
          <ItemRedes />
        </div>

        <div class="flex flex-col space-y-1">
          <TitlesComponent titulo='Política de envíos' estilo='text-lg font-bold my-4' tamaño='h3'/>
          <ParrafoComponent parrafo='Solo realizamos envíos nacionales por el momento, ya que para realizar un envío internacional tendríamos que contar con una autorización de aduanas, la cual no poseemos.' estilo='text-gray-800 text-md'/>
          
        </div>
      </div>
    </div>

   
  </div>
</main>
    
</Layout>