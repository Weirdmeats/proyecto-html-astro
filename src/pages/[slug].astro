---
import Layout from "../layouts/Layout.astro"
import { ItemProduct } from "../data/ItemProduct";
import ProductDetailComponent from "../components/ProductDetailComponent.astro";

//mapeamos las rutas dinamicas del slug
export async function getStaticPaths() {
  return ItemProduct.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
//buscamos el mapeo  dentro del producto en ItemProduct.ts
const producto = ItemProduct.find((item) => item.slug === slug);
---

<Layout>
    <!--colocamos el ProductDetailComponent con el find del mapeo-->
    <ProductDetailComponent producto={producto} />
    
</Layout>