---
import Layout from "../../layouts/Layout.astro"
//import { ItemProduct } from "../data/ItemProduct"; ELIMINADO
//cambie el itemproduct.ts del que sacabamos los datos por el products.json
import ProductDetailComponent from "../../components/ProductDetailComponent.astro";
//import products from "../data/products.json" ELIMINADO
//cambie el products.json local por un json web en jsonplaceholder para extraer data de la forma que pasamos en clase
const { slug } = Astro.params;
interface ProductDataInterface{
    slug: string,
    categoria: string,
    marca: string,
    modelo: string,
    descripcion: string,
    imagen: string,
    precio: number
} 
//mapee de forma asincronica el getstaticpats para evitar errores, al no colocarlo no sabe que o cuentas rutas generar
export async function getStaticPaths() {
  const response = await fetch("https://my-json-server.typicode.com/Weirdmeats/products-json/products");
  const products: ProductDataInterface[] = await response.json();
  
  return products.map((item) => ({
    params: {slug: item.slug},
  }));
}

//buscamos el mapeo  dentro del json subido a github
const response = await fetch('https://my-json-server.typicode.com/Weirdmeats/products-json/products');
const products: ProductDataInterface[]= await response.json();
//cambiamos el mapeo del products.map por .find porque daba error
const producto = products.find((item) => item.slug === slug);
---

<Layout>
    <!--colocamos el productdetiailcomponent con el find-->
    <ProductDetailComponent producto={producto} />
    
</Layout>

